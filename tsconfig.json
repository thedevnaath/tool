{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@lib/*": ["src/lib/*"],
      "@components/*": ["src/components/*"],
      "@workers/*": ["src/workers/*"]
    },
    "types": ["astro/client", "svelte"]
  },
  "include": [".astro/types.d.ts", "**/*", "src/**/*.ts", "src/**/*.svelte"],
  "exclude": ["dist", "node_modules"]
}
---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <section class="mx-auto max-w-2xl space-y-5 pt-16 pb-12">
    <p class="text-mono-eyebrow font-mono text-cyan uppercase tracking-[0.18em]">Contact</p>
    <h1 class="text-heading-lg font-semibold text-ink">Get in touch.</h1>
    <div class="space-y-4 text-body-lg text-body">
      <p>Have questions, feedback, or need support? We'd love to hear from you.</p>
      <p>You can reach out via email at: <a href="mailto:[YOUR_EMAIL_HERE]" class="text-cyan hover:underline">[YOUR_EMAIL_HERE]</a></p>
    </div>
  </section>
</Layout>

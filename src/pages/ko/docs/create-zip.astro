---
import Layout from '../../../layouts/Layout.astro';
import { getCreateZipHowToSchema } from '../../../lib/howto-schema';

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "문서",
      "item": new URL('/ko/docs/', Astro.site).href
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": "ZIP 만들기",
      "item": Astro.url.href
    }
  ]
};

const howToSchema = getCreateZipHowToSchema(Astro.url.href, 'ko');
---

<Layout 
  title="온라인으로 ZIP 파일 만드는 방법 — 문서" 
  description="온라인으로 ZIP 파일을 생성하기 위한 단계별 안내 문서입니다. 파일 선택, 압축 수준 조절, AES 비밀번호 암호화 및 로컬 처리 기반의 프라이버시 아키텍처를 다룹니다."
>
  <article class="mx-auto max-w-2xl px-4 sm:px-6 pt-16 pb-24">

    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-body-sm font-mono text-mute mb-10">
      <a href="/ko/docs/" class="underline underline-offset-4 hover:text-ink transition-colors">문서</a>
      <span class="text-faint">/</span>
      <span class="text-ink">ZIP 만들기</span>
    </nav>
    <script type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbSchema)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(howToSchema)} />

    <!-- Page Header -->
    <header class="space-y-5 mb-[100px]">
      <p class="text-mono-eyebrow font-mono text-ink uppercase tracking-[0.18em]">문서</p>
      <h1 class="text-heading-lg font-semibold text-ink tracking-tight">온라인으로 ZIP 파일 만들기</h1>
      <p class="text-body-lg text-body leading-relaxed">
        이 문서는 기기 내에서 로컬로 파일을 안전하게 패키징하는 브라우저 기반 압축 도구인 <a href="/ko/create/" class="text-ink underline underline-offset-4 hover:text-mute transition-colors">ZIP 만들기</a>의 아카이브 생성 워크플로우를 안내합니다. 압축 해제 도구와 마찬가지로 어떠한 데이터도 원격 서버로 업로드되지 않습니다. 아래에서 파일 추가, 압축 수준 설정, 암호화 구성 및 보안 모델을 살펴보실 수 있습니다.
      </p>
    </header>

    <!-- Table of Contents -->
    <nav class="mb-[100px] py-6 border-y border-hairline">
      <p class="text-heading-sm font-semibold text-ink mb-4">목차</p>
      <ol class="space-y-2 text-body-md text-body list-decimal list-inside">
        <li><a href="#how-it-works" class="underline underline-offset-4 hover:text-ink transition-colors">작동 원리</a></li>
        <li><a href="#adding-files" class="underline underline-offset-4 hover:text-ink transition-colors">파일 및 폴더 추가</a></li>
        <li><a href="#compression-levels" class="underline underline-offset-4 hover:text-ink transition-colors">압축 수준 설정</a></li>
        <li><a href="#password-encryption" class="underline underline-offset-4 hover:text-ink transition-colors">비밀번호 설정 (암호화)</a></li>
        <li><a href="#generating" class="underline underline-offset-4 hover:text-ink transition-colors">생성 및 다운로드</a></li>
        <li><a href="#interface-glossary" class="underline underline-offset-4 hover:text-ink transition-colors">인터페이스 용어 사전</a></li>
        <li><a href="#use-cases" class="underline underline-offset-4 hover:text-ink transition-colors">주요 활용 사례</a></li>
        <li><a href="#privacy" class="underline underline-offset-4 hover:text-ink transition-colors">프라이버시 및 보안 아키텍처</a></li>
        <li><a href="#ux-patterns" class="underline underline-offset-4 hover:text-ink transition-colors">UX 패턴 및 사용 편의성</a></li>
        <li><a href="#troubleshooting" class="underline underline-offset-4 hover:text-ink transition-colors">문제 해결</a></li>
      </ol>
    </nav>

    <!-- Sections -->
    <div class="space-y-[48px]">

      <!-- 1. How It Works -->
      <section id="how-it-works" class="scroll-mt-24 space-y-4 border border-hairline rounded-lg p-6 sm:p-8">
        <h2 class="text-heading-md font-semibold text-ink">작동 원리</h2>
        <p class="text-body-lg text-body leading-relaxed">
          ZIP 생성 도구에 파일을 추가하면 브라우저가 로컬 저장소에서 데이터를 직접 읽어옵니다. 네트워크를 통해 외부 서버로 데이터를 보내는 대신, <strong class="text-ink font-medium">WebAssembly</strong>와 최신 자바스크립트를 활용하여 브라우저 탭 내부에서 직접 파일을 묶고 압축합니다.
        </p>
        <p class="text-body-lg text-body leading-relaxed">
          이러한 로컬 실행 방식은 세 가지 큰 이점을 제공합니다. 파일 업로드와 다운로드를 기다릴 필요가 없어 압도적으로 빠르며, 파일이 기기를 떠나지 않으므로 완벽한 프라이버시가 보장되고, 페이지가 로드된 후에는 불안정한 네트워크 환경에서도 안정적으로 동작합니다.
        </p>
      </section>

      <!-- 2. Adding Files -->
      <section id="adding-files" class="scroll-mt-24 space-y-4 border border-hairline rounded-lg p-6 sm:p-8">
        <h2 class="text-heading-md font-semibold text-ink">파일 및 폴더 추가</h2>
        <p class="text-body-lg text-body leading-relaxed">
          본 도구는 단일 파일뿐만 아니라 복잡한 하위 폴더 구조까지 손쉽게 처리할 수 있도록 설계되었습니다. 여러 방식으로 파일을 준비할 수 있습니다:
        </p>
        <ul class="space-y-3 text-body-lg text-body leading-relaxed list-disc list-outside pl-5">
          <li><strong class="text-ink font-medium">드래그 앤 드롭</strong> — 데스크톱 탐색기에서 여러 파일이나 폴더 전체를 선택하여 브라우저 창으로 끌어다 놓습니다. 드롭 영역이 이를 즉시 감지하여 목록에 등록합니다.</li>
          <li><strong class="text-ink font-medium">시스템 파일 선택기</strong> — "파일 추가" 영역을 클릭하여 운영체제의 기본 파일 선택 창을 엽니다. <kbd class="font-mono text-body-sm bg-canvas-elevated px-1 py-0.5 rounded border border-hairline">Ctrl</kbd> 또는 <kbd class="font-mono text-body-sm bg-canvas-elevated px-1 py-0.5 rounded border border-hairline">Cmd</kbd> 키를 누른 채 여러 파일을 한 번에 선택할 수 있습니다.</li>
        </ul>
        <p class="text-body-lg text-body leading-relaxed">
          추가된 파일은 준비 목록에 깔끔하게 나열됩니다. 잘못 추가한 파일이 있다면 압축을 시작하기 전에 개별 항목을 손쉽게 제거할 수 있습니다.
        </p>
      </section>

      <!-- 3. Compression Levels -->
      <section id="compression-levels" class="scroll-mt-24 space-y-4 border border-hairline rounded-lg p-6 sm:p-8">
        <h2 class="text-heading-md font-semibold text-ink">압축 수준 설정</h2>
        <p class="text-body-lg text-body leading-relaxed">
          작업 목적에 따라 처리 속도와 압축률의 균형을 맞출 수 있습니다. ZIP 파일은 무손실 압축(Lossless Compression) 방식을 사용하므로 어떤 압축 수준을 선택하더라도 원본 데이터와 품질은 100% 온전하게 보존됩니다.
        </p>
        <ul class="space-y-3 text-body-lg text-body leading-relaxed list-disc list-outside pl-5">
          <li><strong class="text-ink font-medium">압축 없음 (가장 빠름)</strong> — 가장 빠른 처리 속도를 제공합니다. 용량을 줄이지 않고 단순히 하나의 파일로 패키징합니다. MP4 동영상이나 JPEG 이미지처럼 이미 자체 압축된 파일에 적합합니다.</li>
          <li><strong class="text-ink font-medium">균형 (기본값)</strong> — 권장되는 기본 설정입니다. 빠른 처리 속도를 유지하면서 용량을 효율적으로 줄여줍니다. 일반적인 문서, 소스 코드, 사진이 섞인 폴더에 이상적입니다.</li>
          <li><strong class="text-ink font-medium">최대 압축 (가장 작음)</strong> — 연산 시간이 조금 더 걸리지만 파일 용량을 가능한 한 최소화합니다. 대용량 텍스트 문서나 비압축 WAV 음원 등을 이메일 첨부 제한 용량에 맞춰 줄여야 할 때 유용합니다.</li>
        </ul>
      </section>

      <!-- 4. Password Encryption -->
      <section id="password-encryption" class="scroll-mt-24 space-y-4 border border-hairline rounded-lg p-6 sm:p-8">
        <h2 class="text-heading-md font-semibold text-ink">비밀번호 설정 (암호화)</h2>
        <p class="text-body-lg text-body leading-relaxed">
          기밀 데이터를 다루는 경우 아카이브를 생성하기 전에 비밀번호로 보호할 수 있습니다. 설정 패널의 비밀번호 입력란에 원하는 비밀번호를 입력하기만 하면 됩니다.
        </p>
        <p class="text-body-lg text-body leading-relaxed">
          본 도구는 안전한 업계 표준 AES 암호화를 적용하여 ZIP 파일을 잠급니다. 중요한 점은 모든 연산이 브라우저 로컬에서 이루어지므로 비밀번호와 원본 파일이 네트워크로 절대 전송되지 않는다는 사실입니다. 수신자는 일반 압축 프로그램(또는 당사의 <a href="/ko/" class="text-ink underline underline-offset-4 hover:text-mute transition-colors">ZIP 압축 풀기</a> 도구)과 올바른 비밀번호를 통해 파일에 안전하게 접근할 수 있습니다.
        </p>
      </section>

      <!-- 5. Generating -->
      <section id="generating" class="scroll-mt-24 space-y-4 border border-hairline rounded-lg p-6 sm:p-8">
        <h2 class="text-heading-md font-semibold text-ink">생성 및 다운로드</h2>
        <p class="text-body-lg text-body leading-relaxed">
          파일 준비와 설정이 완료되면 "ZIP 생성" 버튼을 클릭합니다. 진행률 표시줄을 통해 압축 작업의 진행 상황을 실시간으로 확인할 수 있습니다.
        </p>
        <p class="text-body-lg text-body leading-relaxed">
          압축이 완료되면 브라우저가 생성된 <code class="font-mono text-body-md bg-canvas-elevated px-1.5 py-0.5 rounded">.zip</code> 파일의 다운로드를 자동으로 시작합니다. 생성 전에 아카이브 이름을 미리 지정할 수 있어 나중에 파일 이름을 바꿀 필요가 없습니다.
        </p>
      </section>

      <!-- 6. Interface Glossary -->
      <section id="interface-glossary" class="scroll-mt-24 space-y-4 border border-hairline rounded-lg p-6 sm:p-8">
        <h2 class="text-heading-md font-semibold text-ink">인터페이스 용어 사전</h2>
        <p class="text-body-lg text-body leading-relaxed">
          ZIP 만들기 도구의 주요 구성 요소에 대한 안내입니다.
        </p>

        <dl class="space-y-5 pt-2">
          <div>
            <dt class="text-heading-sm font-semibold text-ink">파일 수집 영역 / 드롭존</dt>
            <dd class="text-body-md text-mute mt-1">파일과 폴더를 끌어다 놓는 기본 영역입니다. 파일이 추가되면 압축 대기 항목을 보여주는 목록 형태로 전환됩니다.</dd>
          </div>
          <div>
            <dt class="text-heading-sm font-semibold text-ink">아카이브 설정 패널</dt>
            <dd class="text-body-md text-mute mt-1">최종 ZIP 파일의 이름을 지정하고, 압축 수준을 선택하며, 비밀번호 보호를 활성화할 수 있는 설정 영역입니다.</dd>
          </div>
          <div>
            <dt class="text-heading-sm font-semibold text-ink">ZIP 생성 버튼</dt>
            <dd class="text-body-md text-mute mt-1">로컬 압축 엔진을 구동하는 주요 동작 버튼입니다. 작업 중에는 실시간 진행 상태가 표시됩니다.</dd>
          </div>
        </dl>
      </section>

      <!-- 7. Use Cases -->
      <section id="use-cases" class="scroll-mt-24 space-y-6 border border-hairline rounded-lg p-6 sm:p-8">
        <h2 class="text-heading-md font-semibold text-ink">주요 활용 사례</h2>

        <div class="space-y-5">
          <div class="space-y-2">
            <h3 class="text-heading-sm font-semibold text-ink">이메일 첨부 파일 용량 한도 준수</h3>
            <p class="text-body-lg text-body leading-relaxed">
              대부분의 이메일 서비스는 첨부 파일 크기를 20~25MB로 제한합니다. 최대 압축 옵션을 활용하면 대용량 PDF 문서, 슬라이드 자료, 텍스트 보고서를 외부 클라우드 링크 없이 이메일 첨부 용량에 맞게 줄일 수 있습니다.
            </p>
          </div>

          <div class="space-y-2">
            <h3 class="text-heading-sm font-semibold text-ink">클라이언트 산출물 보안 전송</h3>
            <p class="text-body-lg text-body leading-relaxed">
              프리랜서와 에이전시는 재무 분석 보고서, 미공개 디자인 시안, 독점 소스 코드 등 기밀 자료를 고객에게 자주 전달합니다. 이러한 결과물을 AES 암호화 ZIP으로 묶으면 이메일이 중간에 노출되더라도 권한 없는 자의 열람을 완벽히 차단할 수 있습니다.
            </p>
          </div>

          <div class="space-y-2">
            <h3 class="text-heading-sm font-semibold text-ink">분산된 프로젝트 파일 깔끔하게 정리</h3>
            <p class="text-body-lg text-body leading-relaxed">
              수십 개의 이미지, 폰트, 텍스트 파일을 개별적으로 보내는 대신 전체 폴더를 그대로 본 도구에 끌어다 놓으세요. 내부 디렉터리 계층을 완벽히 유지한 단일 <code class="font-mono text-body-md bg-canvas-elevated px-1.5 py-0.5 rounded">.zip</code> 파일로 깔끔하게 정리해 공유할 수 있습니다.
            </p>
          </div>
        </div>
      </section>

      <!-- 8. Privacy -->
      <section id="privacy" class="scroll-mt-24 space-y-4 border border-hairline rounded-lg p-6 sm:p-8">
        <h2 class="text-heading-md font-semibold text-ink">프라이버시 및 보안 아키텍처</h2>
        <p class="text-body-lg text-body leading-relaxed">
          ZIP 만들기 도구는 제로놀리지(Zero-Knowledge) 아키텍처를 기반으로 설계되었습니다. 통상적인 '온라인 도구'라는 명칭과 달리, 저희는 웹을 사용자 인터페이스 전달 수단으로만 사용하며 실제 모든 압축 및 암호화 연산은 사용자 기기의 메모리 내부에서 완료됩니다.
        </p>
        <p class="text-body-lg text-body leading-relaxed">
          저희는 사용자 파일을 저장하기 위한 별도의 저장 서버를 운영하거나 임대하지 않습니다. 따라서 데이터 침해, 우발적인 정보 유출, 제3자의 무단 접근 위험이 기술적으로 존재하지 않습니다. 자세한 내용은 <a href="/ko/privacy/" class="text-ink underline underline-offset-4 hover:text-mute transition-colors">개인정보처리방침</a>을 참조하세요.
        </p>
      </section>

      <!-- 9. UX Patterns -->
      <section id="ux-patterns" class="scroll-mt-24 space-y-4 border border-hairline rounded-lg p-6 sm:p-8">
        <h2 class="text-heading-md font-semibold text-ink">UX 패턴 및 사용 편의성</h2>
        <p class="text-body-lg text-body leading-relaxed">
          네이티브 데스크톱 앱과 같은 매끄러운 사용감을 제공합니다:
        </p>
        <ul class="space-y-3 text-body-lg text-body leading-relaxed list-disc list-outside pl-5">
          <li><strong class="text-ink font-medium">인위적인 제한 없음</strong> — 서버 대역폭을 소비하지 않으므로 파일 개수나 전체 용량에 인위적인 제한을 두지 않습니다. 기기의 가용 RAM만 충분하다면 얼마든지 대용량 작업이 가능합니다.</li>
          <li><strong class="text-ink font-medium">스마트폰 최적화</strong> — 모바일 브라우저에서도 원활하게 동작합니다. iPhone이나 Android 사진 보관함에서 여러 장의 사진을 선택하여 브라우저에서 바로 하나의 ZIP으로 압축할 수 있습니다.</li>
          <li><strong class="text-ink font-medium">화면 멈춤 없는 처리</strong> — 무거운 압축 작업을 수행하는 동안에도 브라우저 스레드가 차단되지 않아 페이지 스크롤 및 탐색이 부드럽게 유지됩니다.</li>
        </ul>
      </section>

      <!-- 10. Troubleshooting -->
      <section id="troubleshooting" class="scroll-mt-24 space-y-4 border border-hairline rounded-lg p-6 sm:p-8">
        <h2 class="text-heading-md font-semibold text-ink">문제 해결</h2>

        <div class="space-y-5 pt-2">
          <div class="space-y-1">
            <h3 class="text-heading-sm font-semibold text-ink">생성 중 브라우저 탭이 재부팅되는 경우</h3>
            <p class="text-body-md text-mute">메모리가 부족한 모바일 기기나 저사양 PC에서 수 기가바이트의 파일을 압축할 때 발생할 수 있습니다. 다른 탭을 닫거나 압축 수준을 '압축 없음'으로 설정하여 메모리 부담을 줄여보세요.</p>
          </div>
          <div class="space-y-1">
            <h3 class="text-heading-sm font-semibold text-ink">압축 후에도 파일 크기가 거의 줄어들지 않는 경우</h3>
            <p class="text-body-md text-mute">MP4, JPEG, MP3 등의 멀티미디어는 이미 고도로 압축된 형식입니다. 이러한 파일들을 ZIP으로 묶으면 하나의 패키지로 정리되지만 물리적으로 더 줄어들지는 않습니다.</p>
          </div>
          <div class="space-y-1">
            <h3 class="text-heading-sm font-semibold text-ink">폴더 계층 구조가 사라진 경우</h3>
            <p class="text-body-md text-mute">폴더 내부의 파일들만 드래그하지 말고, 상위 폴더 자체를 도구 창으로 끌어다 놓으세요. 폴더를 직접 추가해야 내부 하위 계층 구조가 그대로 유지됩니다.</p>
          </div>
        </div>
      </section>


---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <section class="mx-auto max-w-2xl space-y-5">
    <p class="text-mono-eyebrow font-mono text-cyan uppercase tracking-[0.18em]">Privacy</p>
    <h1 class="text-heading-lg font-semibold text-ink">Your files stay in your browser.</h1>
    <p class="text-body-lg text-body">Unzip Files Online processes archives locally with browser APIs. Files are not uploaded to a server or stored by this application.</p>
  </section>
</Layout>
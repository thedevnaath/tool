---
import Layout from '../layouts/Layout.astro';
---

<Layout title="404 - Page Not Found">
  <section class="mx-auto max-w-2xl space-y-5 pt-16 pb-12">
    <p class="text-mono-eyebrow font-mono text-cyan uppercase tracking-[0.18em]">404</p>
    <h1 class="text-heading-lg font-semibold text-ink">Page not found.</h1>
    <div class="space-y-4 text-body-lg text-body">
      <p>The page you are looking for doesn't exist or has been moved.</p>
      <p><a href="/" class="text-cyan hover:underline">Go back to homepage</a></p>
    </div>
  </section>
</Layout>

---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <section class="mx-auto max-w-2xl space-y-5">
    <p class="text-mono-eyebrow font-mono text-cyan uppercase tracking-[0.18em]">About</p>
    <h1 class="text-heading-lg font-semibold text-ink">A small tool for moving files around.</h1>
    <p class="text-body-lg text-body">Extract ZIP archives, preview common files, and create new archives without handing your files to a third party.</p>
  </section>
</Layout>
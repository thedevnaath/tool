---
import ModeToggle from '../components/ui/ModeToggle.svelte';
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>Unzip Files Online - Extract & Create ZIP Archives in Your Browser</title>
    <meta name="description" content="Extract ZIP files or create new ZIP archives entirely in your browser. No uploads, no server, complete privacy. Supports large files, previews, and batch operations." />
    <meta name="theme-color" content="#171717" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#fafafa" media="(prefers-color-scheme: light)" />
    <script is:inline>
      const savedTheme = localStorage.getItem('theme');
      if (savedTheme === 'light') document.documentElement.classList.remove('dark');
      else document.documentElement.classList.add('dark');
    </script>
    
    <link rel="preconnect" href="https://cdn.umami.is" />
    <script defer src="https://cdn.umami.is/script.js" data-website-id={import.meta.env.PUBLIC_UMAMI_WEBSITE_ID || ''}></script>
    
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <noscript>
      <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fontsource/geist@5.0.0/index.css" />
      <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fontsource/geist-mono@5.0.0/index.css" />
    </noscript>
  </head>
  <body class="min-h-screen flex flex-col">
    <header class="border-b border-hairline bg-canvas/80 backdrop-blur-sm sticky top-0 z-40">
      <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8" aria-label="Main navigation">
        <div class="flex items-center justify-between h-16">
          <div class="flex items-center gap-6">
            <a href="/" class="flex items-center gap-3 text-dark-ink hover:opacity-80 transition-opacity" aria-label="Unzip Files Online Home">
              <span class="flex h-9 w-9 items-center justify-center rounded-full bg-cyan text-[#071c2f] shadow-whisper">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
              </svg>
              </span>
              <span class="font-sans font-bold text-heading-md tracking-tight hidden sm:block">Unzip Files Online</span>
            </a>
          </div>

          <div class="flex items-center gap-4">
            <ModeToggle client:only="svelte" />
          </div>
        </div>
      </nav>
    </header>

    <main class="flex-1 w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
      <slot />
    </main>

    <footer class="border-t border-hairline bg-canvas/70 py-12">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex flex-col md:flex-row items-center justify-between gap-4 text-body-sm text-mute">
          <p>All processing happens in your browser. No files are uploaded to any server.</p>
          <div class="flex items-center gap-6">
            <a href="/privacy" class="hover:text-ink transition-colors">Privacy</a>
            <a href="/about" class="hover:text-ink transition-colors">About</a>
            <a href="https://github.com" target="_blank" rel="noopener noreferrer" class="hover:text-ink transition-colors" aria-label="GitHub">
              <span>GitHub</span>
            </a>
          </div>
        </div>
      </div>
    </footer>

    <script is:inline>
      if (typeof navigator !== 'undefined' && 'serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js').catch(() => {});
        });
      }
    </script>
  </body>
</html>